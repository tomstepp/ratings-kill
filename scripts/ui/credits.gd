class_name Credits
extends Screen
## Credits, then the Godot Engine license and every third-party notice the
## engine ships with (its license requires them). Scrolls on its own;
## Up/Down to scroll faster, Jump or Esc to go back.

const COLS := 50
const LINE_H := 9
const TOP := 26
const ROWS := 15
const AUTO_SPEED := 18.0  # px per second
const FAST_SPEED := 160.0
const CREDITS := [
	"RATINGS KILL",
	"",
	"A GAME BY TOM STEPP",
	"",
	"DESIGN, CODE, ART AND MUSIC MADE FOR THIS GAME.",
	"EVERY SPRITE, TILE, FONT AND TUNE IS GENERATED BY",
	"THE PROJECT'S OWN TOOLS. NO ASSET PACKS.",
	"",
	"MADE WITH THE GODOT ENGINE (GODOTENGINE.ORG)",
	"DIALOGUE VOICED BY YOUR SYSTEM'S TEXT-TO-SPEECH.",
	"",
	"NO MASCOTS, FLOOR MANAGERS OR DIRECTORS WERE",
	"HARMED. THE SHOWRUNNER IS FINE. IT'S ALWAYS FINE.",
	"",
	"",
]

var _lines: PackedStringArray
var _labels: Array[Label] = []
var _scroll := -40.0


func _ready() -> void:
	backdrop(0.8)
	centered("CREDITS", 6, Art.c("gold"), 2)
	centered("UP/DOWN SCROLL    JUMP OR ESC: BACK", 168, Art.c("metal"))
	_lines = PackedStringArray(CREDITS)
	for raw in LicenseText.full().split("\n"):
		_lines.append_array(_wrap(raw))
	for i in ROWS + 1:
		var l := Art.label("", Art.c("steel"))
		l.position = Vector2(10, 0)
		add_child(l)
		_labels.append(l)
	scanlines()
	Showrunner.clear()


func _wrap(text: String) -> PackedStringArray:
	var out := PackedStringArray()
	var line := ""
	for word in text.strip_edges(false, true).split(" "):
		while word.length() > COLS:
			if line != "":
				out.append(line)
				line = ""
			out.append(word.substr(0, COLS))
			word = word.substr(COLS)
		if line == "":
			line = word
		elif line.length() + 1 + word.length() <= COLS:
			line += " " + word
		else:
			out.append(line)
			line = word
	out.append(line)
	return out


func _process(delta: float) -> void:
	super(delta)
	var speed := AUTO_SPEED
	if Input.is_action_pressed("move_down"):
		speed = FAST_SPEED
	elif Input.is_action_pressed("move_up"):
		speed = -FAST_SPEED
	var limit := float(_lines.size() * LINE_H - ROWS * LINE_H)
	_scroll = clampf(_scroll + speed * delta, -40.0, limit)
	var first := floori(_scroll / LINE_H)
	for i in _labels.size():
		var n := first + i
		var l := _labels[i]
		l.position.y = TOP + n * LINE_H - _scroll
		var shown := n >= 0 and n < _lines.size() and l.position.y >= TOP - 2 and l.position.y <= TOP + ROWS * LINE_H
		l.visible = shown
		if shown:
			l.text = _lines[n]
			l.add_theme_color_override("font_color", Art.c("gold") if n == 0 else Art.c("white") if n < CREDITS.size() else Art.c("steel"))
	if confirm_pressed() or Input.is_action_just_pressed("pause"):
		set_process(false)
		Sfx.play("blip", 0.8)
		GameState.main.show_title()
